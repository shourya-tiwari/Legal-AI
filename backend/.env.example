# backend/.env.example -- copy to backend/.env and adjust.
#
# Every value here has a safe default in app/config.py; this file is the
# "self-hosted stack wired up" profile produced by scripts/bootstrap_selfhosted.sh.
# Leave a line commented / empty to fall back to the Class-A offline default.

# ---- Model Router: self-hosted generation (Class B) ----------------------
# Ollama's OpenAI-compatible endpoint (docker compose --profile gpu up -d).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
# Escalation target on the same endpoint -- used when a caller passes hard=True
# (Phase 6). Needs `ollama pull qwen3:14b`.
LLM_LARGE_MODEL=qwen3:14b

# ---- Model Router: self-hosted embeddings (Class B) ---------------------
# A Text Embeddings Inference container serving BAAI/bge-m3.
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# ---- Model Router: self-hosted reranker (Class B) ----------------------
# A second TEI container serving BAAI/bge-reranker-v2-m3 (native /rerank route).
RERANKER_BASE_URL=http://localhost:8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_ENABLED=true

# ---- Phase 6 in-process models (Class A/B) -- need requirements-local.txt --
# NLI faithfulness head for the Verifier agent (in-process transformers).
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_ENABLED=true
# GLiNER zero-shot NER, merged with regex extraction in nlp/entities.py.
NER_MODEL=urchade/gliner_multi-v2.1
NER_ENABLED=true

# ---- Class C (external providers) -------------------------------------
# false => every request stays on self-hosted providers. Flip to true (and
# set GOOGLE_API_KEY) only for the cloud profile with per-org opt-in; Class C
# is still never used for confidential/privileged documents.
EXTERNAL_PROVIDERS_ENABLED=false
STRICT_LOCAL_ONLY=false
GOOGLE_API_KEY=
GENAI_MODEL=gemini-flash-latest

# ---- Persistence -----------------------------------------------------
# docker compose up -d brings up this Postgres. Note the +psycopg (psycopg3).
DATABASE_URL=postgresql+psycopg://legalai:legalai@localhost:5432/legalai
REDIS_URL=redis://localhost:6379/0
MEMGRAPH_URI=bolt://127.0.0.1:7687

# ---- Auth / rate limiting -------------------------------------------
AUTH_REQUIRED=false
RATE_LIMIT_PER_MINUTE=60

# ---- Observability (Phase 5) ---------------------------------------
# model_calls persistence is on by default. OTEL is off until you point it at
# a self-hosted collector (Langfuse OTLP ingest / SigNoz / Grafana Alloy).
MODEL_CALL_LOGGING=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=legalai-backend
